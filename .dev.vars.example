WOMPI_API_SECRET="replace-with-wompi-secret"
# Deterministic local-only Stripe transport. Production rejects this setting.
STRIPE_MOCK_MODE="1"
# For a real sandbox smoke test, remove STRIPE_MOCK_MODE and provide these through
# an untracked owner-only .dev.vars file. Use a restricted key, never an sk_ key.
# STRIPE_RESTRICTED_KEY="rk_test_replace-with-restricted-key"
# STRIPE_PUBLISHABLE_KEY="pk_test_replace-with-publishable-key"
# STRIPE_WEBHOOK_SECRET="whsec_replace-with-endpoint-secret"
# STRIPE_PAYMENT_METHOD_CONFIGURATION_ID="pmc_replace-with-donor-safe-config"
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID="bpc_replace-with-spanish-portal-config"
# STRIPE_US_LEGAL_NAME="Replace with exact US 501(c)(3) legal name"
# STRIPE_US_EIN="00-0000000"
# Optional only when local workerd cannot make outbound HTTPS requests. Run
# `npm run dev:stripe-api-proxy`; staging and production reject this override.
# STRIPE_API_PROXY_URL="http://127.0.0.1:8791"
# OAuth client-credentials for minting single-use Wompi payment links (donor checkout).
# Obtain from the Wompi dashboard; used against https://id.wompi.sv/connect/token.
# WOMPI_CLIENT_ID="replace-with-wompi-client-id"
# WOMPI_CLIENT_SECRET="replace-with-wompi-client-secret"
# Replace this fixture with `bt_` plus 32 random base64url bytes (43 characters).
BOOTSTRAP_OWNER_TOKEN="bt_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
CLOUDFLARE_ACCOUNT_ID="replace-with-cloudflare-account-id-for-ui-secret-writes"
CLOUDFLARE_API_TOKEN="replace-with-workers-secrets-edit-token-for-ui-secret-writes"
MH_CERT_PASSWORD="replace-with-mh-private-key-password"
MH_CERT_XML="paste-ministerio-hacienda-certificado-xml-here"
# Cloudflare Workers secrets are capped at 5 KB. For remote deploys with a larger certificate,
# split the same XML across MH_CERT_XML_PART_1 and MH_CERT_XML_PART_2 instead.
# MH_CERT_XML_PART_1="first-half-of-certificado-xml"
# MH_CERT_XML_PART_2="second-half-of-certificado-xml"
MH_USER_TEST="replace-with-mh-test-api-user"
MH_PASSWORD_TEST="replace-with-mh-test-api-password"
MH_USER_PROD="replace-with-mh-production-api-user"
MH_PASSWORD_PROD="replace-with-mh-production-api-password"
# Optional deployment-owned fallback when Cloudflare Email Service is limited to verified destinations.
# Must be an absolute HTTPS URL without embedded credentials; never set it from the credentials panel.
# After the new binding is deployed and verified, delete the superseded endpoint secret from that deployment.
# This repository example does not modify staging or production configuration.
# EMAIL_PROVIDER_URL="https://email-provider.example/send"
# EMAIL_API_KEY="replace-with-email-provider-api-key"
EMAIL_FROM="dte@example.org"
# Use single quotes so wrangler keeps the inner double quotes intact (no backslash escapes).
EMISOR_CONFIG_JSON='{"tipoDocumento":"36","numDocumento":"10000000000001","nrc":null,"nombre":"Iglesia Demo","codActividad":"94910","descActividad":"Actividades de organizaciones religiosas","nombreComercial":"Iglesia Demo","direccion":{"departamento":"06","municipio":"22","distrito":"01","complemento":"San Salvador, El Salvador"},"telefono":"70000003","correo":"dte@example.org","codEstable":"0001","codEstableMH":"0001","codPuntoVenta":"01","codPuntoVentaMH":"0001","controlPrefix":"00010001","defaultReceptorTipoDocumento":"13","defaultCodPais":"SV","defaultDonationType":1,"defaultUnidadMedida":99,"paymentMethodCode":null,"responsable":{"nombre":"Responsable Legal","tipoDocumento":"13","numeroDocumento":"000000000","tipoEstablecimiento":"02"}}'
